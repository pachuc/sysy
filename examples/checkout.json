      "y": 0.0
    },
    "catalog": {
      "x": 1344.0,
      "y": 0.0
    },
    "checkout": {
      "x": 896.0,
      "y": 0.0
    },
    "commerce": {
      "x": 416.0,
      "y": -32.0,
      "size": {
        "width": 2040.0,
        "height": 264.0
      }
    },
    "delivery": {
