      "y": 252.0
    },
    "events": {
      "x": 1344.0,
      "y": 408.0
    },
    "fulfillment": {
      "x": 1312.0,
      "y": 272.0,
      "size": {
        "width": 1144.0,
        "height": 336.0
      }
    },
    "gateway": {
      "x": 448.0,
      "y": 0.0
    },
    "idempotency": {
      "x": 1544.0,
      "y": 104.0
    },
    "inventory": {
      "x": 1792.0,
      "y": 408.0
    },
    "ledger": {
      "x": 1792.0,
      "y": 104.0
    },
    "orders": {
